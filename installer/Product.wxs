<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCode)" Name="JXL Studio" Language="1033"
           Version="$(var.ProductVersion)" Manufacturer="JXL Studio"
           UpgradeCode="4A3C5072-4B57-4EDA-88E1-BD96151AEC98">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             InstallPrivileges="limited" Platform="x64"
             Description="JPEG XL converter and viewer" />
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of JXL Studio is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <!-- Windows Installer intentionally reports VersionNT=603 on Windows 10/11. -->
    <Property Id="WINDOWS_BUILD">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM" Win64="yes"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" />
    </Property>
    <Condition Message="JXL Studio requires 64-bit Windows 10 or later.">Installed OR (VersionNT64 AND WINDOWS_BUILD &gt;= 10240)</Condition>
    <Property Id="ARPHELPLINK" Value="https://github.com/conmmitmentman/jxl-studio" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/conmmitmentman/jxl-studio" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <UIRef Id="WixUI_Minimal" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="JXL Studio" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="JXL Studio" />
      </Directory>
    </Directory>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="InstallerRegistration" Guid="*" Win64="yes">
        <RegistryKey Root="HKCU" Key="Software\JXLStudio\Installer" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </RegistryKey>
        <RemoveFolder Id="RemoveInstallDirectory" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsDirectoryIfEmpty" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
        <Shortcut Id="StartMenuShortcut" Name="JXL Studio"
                  Description="JPEG XL converter and viewer"
                  Target="[INSTALLDIR]jxl-studio.exe" WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="RemoveStartMenuDirectory" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\JXLStudio\Installer"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="Complete" Title="JXL Studio" Level="1" Absent="disallow">
      <ComponentRef Id="InstallerRegistration" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="PackageFiles" />
    </Feature>
  </Product>
</Wix>
